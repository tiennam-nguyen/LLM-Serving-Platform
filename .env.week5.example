# Trusted Bash configuration, sourced by the lab launchers. Copy to .env.week5.
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
HOST_A_IP=REPLACE_WITH_HOST_A_LAN_IP
HOST_B_IP=REPLACE_WITH_HOST_B_LAN_IP
WORKER_A_ID=worker-vllm-a
WORKER_B_ID=worker-vllm-b
WORKER_PORT=8000
# Host A constructs canonical WORKER_ENDPOINTS (one line, comma separated):
# worker-vllm-a=http://HOST_A_IP:8000,worker-vllm-b=http://HOST_B_IP:8000
# An exported WORKER_ENDPOINTS can instead supply two explicit id=http://host:port entries.

VLLM_HOST=0.0.0.0
VLLM_PORT=8000
GPU_MEMORY_UTILIZATION=0.6
MAX_MODEL_LEN=2048
SWAP_SPACE_GB=1
CUDA_VISIBLE_DEVICES=0
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
ROUTING_POLICY=round_robin
HEALTH_CHECK_INTERVAL_S=2
HEALTH_CHECK_TIMEOUT_S=1
VLLM_TIMEOUT_S=60
NO_GPU=0
