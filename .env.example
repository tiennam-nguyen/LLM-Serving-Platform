# ==============================================================================
# LLM Serving Platform - Local Environment Configuration (.env.example)
# ==============================================================================
#
# COPY THIS FILE TO `.env` FOR LOCAL DEVELOPMENT:
#   cp .env.example .env
#
# RULES:
# 1. Never commit real API keys, credentials, or production tokens to Git.
# 2. `.env` is ignored by Git; `.env.example` contains provisional placeholders only.
# 3. Environment variables defined here are provisional and subject to refinement
#    in upcoming weekly milestones.
# ==============================================================================

# Environment mode (development | testing | production)
ENV_MODE=development

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Future Gateway Server (Provisional placeholders - not active in bootstrap)
# GATEWAY_HOST=0.0.0.0
# GATEWAY_PORT=8000

# Future Worker / Serving Runtime (Provisional - not active in bootstrap)
# VLLM_HOST=127.0.0.1
# VLLM_PORT=8001
# MODEL_NAME=Qwen/Qwen2.5-Coder-1.5B-Instruct
