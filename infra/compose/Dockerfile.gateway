FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src

WORKDIR /app

# Create non-root service user and group (UID/GID 10001)
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /usr/sbin/nologin -M appuser

COPY pyproject.toml README.md ./
COPY src/ ./src/

# Install gateway runtime dependencies without heavy local GPU wheels
RUN pip install --no-deps . && \
    pip install "fastapi>=0.110.0" "httpx>=0.27.0" "uvicorn>=0.29.0" "pydantic>=2.6.0"

USER 10001:10001
EXPOSE 8080

CMD ["python", "-m", "uvicorn", "llm_serving_platform.gateway.main:app", "--host", "0.0.0.0", "--port", "8080"]
