# Pin patched Node.js 22.23.4 LTS (>= 22.23.4) to address CVE-2026-111497
FROM node:22.23.4-slim AS builder

WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web/ ./
ARG NEXT_PUBLIC_DEFAULT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
ARG NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8080
ENV NEXT_PUBLIC_DEFAULT_MODEL=${NEXT_PUBLIC_DEFAULT_MODEL} \
    NEXT_PUBLIC_GATEWAY_URL=${NEXT_PUBLIC_GATEWAY_URL}

RUN npm run build

FROM node:22.23.4-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN groupadd -g 10001 webgroup && \
    useradd -u 10001 -g webgroup -s /usr/sbin/nologin -M webuser

COPY --from=builder --chown=10001:10001 /app ./

USER 10001:10001
EXPOSE 3000

CMD ["npx", "next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
