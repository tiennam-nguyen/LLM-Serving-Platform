# Exact model served by your vLLM worker
NEXT_PUBLIC_DEFAULT_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Direct browser-to-gateway URL (uses FastAPI Backend CORS)
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8080

# Optional control API base; blank uses NEXT_PUBLIC_GATEWAY_URL.
# Member A must mount /control/v1/workers before records are available.
NEXT_PUBLIC_CONTROL_API_URL=

# Server-side fallback URL for optional Next.js relay route
GATEWAY_URL=http://127.0.0.1:8080
