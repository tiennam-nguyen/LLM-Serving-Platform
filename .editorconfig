# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yaml,yml,md,toml}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,html}]
indent_size = 2

[Makefile]
indent_style = tab
